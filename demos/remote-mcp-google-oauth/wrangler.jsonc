/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phn-youtube-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  // The URL MCP clients connect to. Set it to your deployed URL, for example
  // https://<worker-name>.<your-subdomain>.workers.dev/mcp
  "workers_dev": true,
  "vars": {
    "MCP_RESOURCE": "https://phn-youtube-mcp.arnab368.workers.dev/mcp",
    "HOSTED_DOMAIN": "",
  },
  "durable_objects": {
    "bindings": [
      { "name": "OAUTH_STATE", "class_name": "OAuthStateDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OAuthStateDO"] }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "eec4880e350447e5a5ca3fb5b53d7322"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
